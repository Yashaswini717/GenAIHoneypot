# Copy to .env, or let tools/bootstrap.py generate it with a random secret.

# Signing key shared with the intelligence hub. MUST match the hub's
# HMAC_SECRET, and MUST NOT be the literal string "dev" — the hub skips
# signature verification for that value, which silently disables zero trust.
HMAC_SECRET=change-me

# Where the intelligence hub is reachable from the sidecar.
# host.docker.internal reaches a hub running on the host during development.
HUB_URL=http://host.docker.internal:8000

# Host port the SSH proxy is published on.
# 2222 locally. Phase 3 sets this to 22, AFTER moving the host's own sshd off
# port 22 — otherwise you lock yourself out of your own VPS.
PROXY_PUBLISH_PORT=2222

# The port attackers believe they reached. Reported as dst_port on every
# event, so telemetry reflects their view rather than our internal binding.
PROXY_ADVERTISED_PORT=22

# How long an attacker's container survives idle before being reaped.
# Long enough that a returning attacker finds their own changes intact.
SESSION_IDLE_TTL=21600

# Ceiling on simultaneous attacker containers, so a distributed campaign
# cannot turn per-IP isolation into memory exhaustion on our own host.
MAX_CONTAINERS=40

BATCH_MAX=50
FLUSH_INTERVAL=1.0
LOG_LEVEL=INFO
